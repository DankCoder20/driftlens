# Generate a real value using python scripts/init-env.py. Never commit .env.
DRIFTLENS_API_TOKEN=replace-with-a-long-random-token
# Native defaults are relative to backend/; Compose sets container paths.
# DRIFTLENS_ADDR=127.0.0.1:8080
# DRIFTLENS_DATA_DIR=../.data
# DRIFTLENS_REPOSITORY_ROOT=../demo
# DRIFTLENS_CREDENTIAL_ROOT=../credentials
# DRIFTLENS_FRONTEND_DIR=../frontend/dist
# DRIFTLENS_ALLOW_EXEC_AUTH=false
# Optional exact command allowlist for operator-provisioned kubeconfigs.
# DRIFTLENS_EXEC_AUTH_COMMANDS=gke-gcloud-auth-plugin.exe
